WECHAT_TOKEN=replace-with-random-token
PUBLIC_BASE_URL=https://your-domain.example
DATABASE_PATH=shadow_saver.db
WECHAT_APP_ID=
WECHAT_ENCODING_AES_KEY=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
JD_APP_KEY=
JD_APP_SECRET=
JD_SITE_ID=

# 淘宝官方活动（活动 ID 从淘宝联盟活动中心获取）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_PID=
TAOBAO_ACTIVITY_ID=
# 或使用联盟后台已经生成的固定活动链接（无需活动 ID）
TAOBAO_ACTIVITY_TITLE=
TAOBAO_ACTIVITY_URL=
TAOBAO_ACTIVITY_TOKEN=
# 带时区的入口停用时间，例如 2026-10-28T23:59:59+08:00
TAOBAO_ACTIVITY_EXPIRES=

# 好单库自有推广位；公众号手机入口使用 mobile:create_mobile_app
HAODANKU_API_KEY=
HAODANKU_TB_NAME=
JD_PID=
PILOT_DATABASE_PATH=pilot.db

# 直接聊天转链：免费额度获批并真实验证后才开启；普通APIKey不能替代V3凭据
DIRECT_LINK_ENABLED=0
HAODANKU_V3_APP_ID=
HAODANKU_V3_APP_SECRET=

# 只读运维状态接口；留空关闭，使用随机私密值，不能放进URL
OPS_STATUS_TOKEN=

# 可选多通道bridge，默认关闭。仅服务器/可信Windows连接器保管凭据。详见docs/IM.md
IM_BRIDGES_JSON=
